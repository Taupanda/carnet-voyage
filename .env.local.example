# Copie ce fichier en .env.local et remplis les valeurs.
# En production, ces variables se configurent dans Vercel (jamais dans le code).
# .env*.local est ignoré par git (voir .gitignore).

# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRET — côté serveur uniquement

# --- Anthropic (interview IA + mise en forme des posts) ---
ANTHROPIC_API_KEY=                    # SECRET

# --- Accès admin (/journal) ---
ADMIN_PASSWORD=                       # SECRET — mot de passe de secours
ADMIN_EMAIL=                          # email de l'admin Google (côté serveur)
NEXT_PUBLIC_ADMIN_EMAIL=              # même email, exposé au client pour l'UI

# --- Carte (Mapbox) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Notifications push (Web Push / VAPID) ---
# Générer avec : npx --yes web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # SECRET

# --- Cron des notifications ---
CRON_SECRET=                          # SECRET — protège /api/cron
TRIP_TIMEZONE=America/Mexico_City     # optionnel — fuseau du voyage
